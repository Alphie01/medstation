# Uygulama yapılandırması. Kopyalayın: cp .env.example .env
# Çalıştırma: flutter run --dart-define-from-file=.env
#
# API adresi: Cloudflare Tunnel'da tanımladığınız alan adı (HTTPS).
API_BASE=https://api.alanadiniz.com
# Release derlemesi yalnızca https kabul eder. Tünel olmadan doğrudan IP:port
# (http) ile geçici test yapılacaksa true yapın.
ALLOW_INSECURE_HTTP=false

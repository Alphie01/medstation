# Uygulama yapılandırması. Kopyalayın: cp .env.example .env
# Çalıştırma: flutter run --dart-define-from-file=.env
#
# API sunucusu (docker compose ile API_PORT, varsayılan 25925).
API_BASE=http://81.168.70.119:25925
# Release derlemesi varsayılan olarak yalnızca https kabul eder. Sunucuya TLS
# (alan adı + ters vekil) eklenene kadar geçici test için true yapılabilir.
ALLOW_INSECURE_HTTP=false

# Docker Compose değişkenleri (bu dosyayı .env olarak kopyalayın: cp .env.example .env).
# API'nin kendi ayarları ve gizli anahtarları server/.env içindedir.

# Cloudflare Tunnel: Zero Trust › Networks › Tunnels › tüneliniz › token.
# Tünelde public hostname olarak http://api:8787 servisini tanımlayın.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Tünel kullanılırken API'yi dışarıya kapatın (yalnızca tünel üzerinden erişim).
API_BIND=127.0.0.1
API_PORT=25925

# Otomatik TİTCK güncelleme sıklığı (30m, 6h, 1d).
SYNC_EVERY=6h
